# ============================================================
# Repo Rizz — Python Backend Environment Template
# ============================================================
# 1. Copy this file to `.env` in this same folder:
#      cp .env.template .env        (macOS / Linux)
#      copy .env.template .env      (Windows)
# 2. Replace each PASTE_... placeholder with your real value.
# 3. Never commit the real `.env` file (it is git-ignored).
#
# This file is a TEMPLATE ONLY. It contains no real secrets.

# Rizz Master admin access code.
# Keep this secret. It is read ONLY by the backend server.
# It is never sent to the browser and must never appear in frontend code.
RIZZ_MASTER_CODE=PASTE_YOUR_SECRET_HERE

# GitHub API token (optional but recommended to avoid rate limits).
GITHUB_TOKEN=PASTE_GITHUB_TOKEN_HERE

# Google Gemini API key (used for AI insights and verdicts).
GEMINI_API_KEY=PASTE_GEMINI_KEY_HERE

# ------------------------------------------------------------
# Optional — Supabase persistence
# ------------------------------------------------------------
# The contributors store uses a local SQLite database by default
# (zero configuration). To use Supabase instead, set both values
# below and run the migration in `supabase/migrations/`.
# Leave them empty to keep the local database.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# Optional — cookie/session behaviour
# ------------------------------------------------------------
# Set COOKIE_SECURE=true when the backend is served over HTTPS
# (makes the admin session cookie Secure). Locally over http://
# keep it false.
# COOKIE_SECURE=false

# Set TRUST_FORWARDED_FOR=true ONLY when running behind a reverse
# proxy that sets X-Forwarded-For. Leave unset when clients connect
# directly (the launcher scripts already run uvicorn with
# --no-proxy-headers so the login rate limiter sees real IPs).
# TRUST_FORWARDED_FOR=false